# TTRPG System Environment Variables
# Copy this file to .env and fill in your actual values

# Cloudflare R2 Storage Configuration
R2_ENABLED=false
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY=your_r2_access_key_here
R2_SECRET_KEY=your_r2_secret_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://your-custom-domain.com
R2_ENDPOINT=
ASSET_MAX_FILE_BYTES=52428800
ASSET_UPLOADS_PER_MINUTE=10
ASSET_UPLOADS_PER_HOUR=50
ASSET_DOWNLOADS_PER_HOUR=2000
ASSET_PRESIGNED_URL_TTL_SECONDS=300
ASSET_MAX_PENDING_UPLOADS_PER_USER=10
ASSET_MAX_ASSETS_PER_USER=500
ASSET_MAX_STORAGE_BYTES_PER_USER=1073741824
# 9 decimal GB leaves headroom below R2 Standard's 10 GB-month free allowance.
ASSET_MAX_TOTAL_STORAGE_BYTES=9000000000
ASSET_MAX_LINKS_PER_SESSION=1000
ASSET_MAX_LINKS_PER_ACTOR_PER_SESSION=250

# JWT Secret (MUST change in production)
JWT_SECRET_KEY=your-secret-key-change-in-production

# Optional: Override default paths
# DEFAULT_STORAGE_PATH=/custom/path/to/storage
