    "data": {
      "type": "object",
      "default": {},
      "additionalProperties": true
    },
    "client_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": [
        "number",
        "null"
      ]
    },
    "version": {
      "type": "string",
      "default": "0.1"
    },
    "priority": {
      "type": "integer",
      "default": 5
    },
    "sequence_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    }
