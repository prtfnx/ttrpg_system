  "$defs": {
    "welcomeData": {
      "type": "object",
      "required": [
        "message",
        "client_id",
        "user_id",
        "username",
        "session_code",
        "connection_id",
        "tables",
        "role",
        "permissions",
        "visible_layers",
        "game_mode",
        "session_rules",
        "choice_encounter"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "integer",
          "minimum": 0
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "session_code": {
          "type": "string",
          "minLength": 1
        },
        "connection_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "enum": [
            "owner",
            "co_dm",
            "trusted_player",
            "player",
            "spectator"
          ]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visible_layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "game_mode": {
          "enum": [
            "free_roam",
            "explore",
            "fight",
            "custom"
          ]
        },
        "session_rules": {
          "type": "object"
        },
        "choice_encounter": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "playerJoinedData": {
      "type": "object",
      "required": [
        "username",
        "user_id",
        "client_id",
        "role",
        "timestamp"
      ],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "integer",
          "minimum": 0
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "owner",
            "co_dm",
            "trusted_player",
            "player",
            "spectator"
          ]
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "playerLeftData": {
      "type": "object",
      "required": [
        "username",
        "timestamp"
      ],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "kicked": {
          "const": true
        },
        "banned": {
          "const": true
        },
        "duration": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "kicked": [
          "reason"
        ],
        "banned": [
          "reason",
          "duration"
        ],
        "duration": [
          "banned"
        ]
      },
      "additionalProperties": false
    },
    "playerRoleChangedData": {
      "type": "object",
      "required": [
        "user_id",
        "new_role",
        "permissions",
        "visible_layers"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 0
        },
        "new_role": {
          "enum": [
            "owner",
            "co_dm",
            "trusted_player",
            "player",
            "spectator"
          ]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visible_layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "actionResultData": {
      "type": "object",
      "required": [
        "accepted",
        "sequence_id",
        "applied"
      ],
      "properties": {
        "accepted": {
          "const": true
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "applied": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "combat": {
          "type": "object"
        },
        "reason": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "actionRejectedData": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "accepted": {
          "const": false
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "applied": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "failed_index": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "boolean"
        },
        "sprite_id": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tableSettingsChangedData": {
      "type": "object",
      "required": [
        "table_id",
        "dynamic_lighting_enabled",
        "fog_exploration_mode",
        "ambient_light_level",
        "grid_cell_px",
        "cell_distance",
        "distance_unit",
        "grid_enabled",
        "snap_to_grid",
        "grid_color_hex",
        "background_color_hex"
      ],
      "properties": {
        "table_id": {
          "type": "string",
          "minLength": 1
        },
        "dynamic_lighting_enabled": {
          "type": "boolean"
        },
        "fog_exploration_mode": {
          "enum": [
            "current_only",
            "persist_dimmed"
          ]
        },
        "ambient_light_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grid_cell_px": {
          "type": "number",
          "minimum": 10,
          "maximum": 500
        },
        "cell_distance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "distance_unit": {
          "enum": [
            "ft",
            "m"
          ]
        },
        "grid_enabled": {
          "type": "boolean"
        },
        "snap_to_grid": {
          "type": "boolean"
        },
        "grid_color_hex": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "background_color_hex": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "welcome"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/$defs/welcomeData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "player_joined"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/$defs/playerJoinedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "player_left"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/$defs/playerLeftData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "player_role_changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/$defs/playerRoleChangedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "action_result"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/$defs/actionResultData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "action_rejected"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/$defs/actionRejectedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "table_settings_changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/$defs/tableSettingsChangedData"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
